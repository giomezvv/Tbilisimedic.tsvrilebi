rules_version = '2';

// Server-side access control for Firebase Storage.
// Deploy:  firebase deploy --only storage   (or paste into Firebase Console → Storage → Rules)
// Keep the admin list below in sync with ADMIN_EMAILS in js/config.js and firestore.rules.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'gio.mezvv@gmail.com'
      ];
    }

    // Ownership is read from the Firestore document, so it matches firestore.rules
    // and follows the lead/task when it is reassigned.
    function ownsDoc(collection, docId) {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/$(collection)/$(docId)).data.userEmail
          == request.auth.token.email;
    }

    // Lead files: the owner, or the lead's creator (matches firestore.rules createdByMe()).
    function canAccessLead(leadId) {
      let lead = firestore.get(/databases/(default)/documents/leads/$(leadId)).data;
      return signedIn() &&
        (lead.userEmail == request.auth.token.email || lead.get('userId', null) == request.auth.uid);
    }

    function validUpload() {
      return request.resource.size < 10 * 1024 * 1024;
    }

    // Product images, logo and stamp: loaded publicly via ?alt=media URLs, only admins change them.
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lead attachments. Files are immutable: replacing one means delete + create.
    match /leads/{leadId}/{fileName} {
      allow read, delete: if isAdmin() || canAccessLead(leadId);
      allow create: if (isAdmin() || canAccessLead(leadId)) && validUpload();
      allow update: if false;
    }

    match /tasks/{taskId}/{fileName} {
      allow read, delete: if isAdmin() || ownsDoc('tasks', taskId);
      allow create: if (isAdmin() || ownsDoc('tasks', taskId)) && validUpload();
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
