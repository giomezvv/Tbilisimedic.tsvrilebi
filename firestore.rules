rules_version = '2';

// Server-side access control for the app. The ADMIN_EMAILS list in js/config.js only
// hides UI — without these rules any signed-in user can read/write everything via the SDK.
// Deploy:  firebase deploy --only firestore:rules   (or paste into Firebase Console → Firestore → Rules)
// Keep the admin list below in sync with ADMIN_EMAILS in js/config.js and storage.rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.email in [
        'gio.mezvv@gmail.com'
      ];
    }

    function ownsExisting() {
      return signedIn() && resource.data.userEmail == request.auth.token.email;
    }

    function ownsNew() {
      return signedIn() && request.resource.data.userEmail == request.auth.token.email;
    }

    // Stock, clients, features, sales history, targets, settings:
    // everyone signed in reads, only admins write.
    match /appData/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // The lead's creator (userId, set once on create) keeps read/edit access after handing the lead to
    // someone else. Matches CREATOR_KEEPS_LEAD_ACCESS = true in js/config.js.
    function createdByMe() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    // Non-admins can never change who created a lead.
    function keepsCreator() {
      return request.resource.data.get('userId', null) == resource.data.get('userId', null);
    }

    // Leads and tasks: admins see everything; managers their own, plus leads they created.
    // Managers may hand a lead they own or created to another user; tasks cannot be reassigned.
    match /leads/{leadId} {
      allow read: if isAdmin() || ownsExisting() || createdByMe();
      allow create: if isAdmin() || (ownsNew() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || ((ownsExisting() || createdByMe()) && keepsCreator());
      allow delete: if isAdmin();
    }

    match /tasks/{taskId} {
      allow read: if isAdmin() || ownsExisting();
      allow create: if isAdmin() || ownsNew();
      allow update: if isAdmin() || (ownsExisting() && ownsNew());
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
